{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "author": "pscholz",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "homepage_url": "https://github.com/pscholz-src/zoom-and-drag",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "__MSG_cmSetting__",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background-script.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content-script.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "settings/options.html"
  },
  "default_locale": "en"
}