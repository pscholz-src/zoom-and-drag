{
	"manifest_version": 3,
	"name": "__MSG_extensionName__",
	"author": "pscholz",
	"description": "__MSG_extensionDescription__",
	"version": "2.1.0",
	"homepage_url": "https://github.com/pscholz-src/zoom-and-drag",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "__MSG_cmSetting__",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"permissions": [
		"contextMenus",
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background-script.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"css": ["style.css"],
			"js": ["content-script.js"],
			"run_at": "document_end",
			"all_frames": true
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["panel.html"],
			"matches": ["<all_urls>"]
		}
	],
	"options_ui": {
		"page": "settings/options.html",
		"open_in_tab": true
	},
	"default_locale": "en"
}